{
  "name": "linterna-premium-mobile",
  "version": "0.3.0",
  "private": true,
  "description": "Comandos portables para la aplicacion Android nativa.",
  "scripts": {
    "android": "node ../../tools/run-native-android.mjs",
    "typecheck": "node ../../tools/verify-project.mjs",
    "format:check": "node ../../tools/verify-project.mjs",
    "test:check-setup": "node ../../tools/verify-project.mjs && node ../../tools/verify-version.mjs",
    "test": "node ../../tools/verify-project.mjs && node ../../tools/verify-version.mjs",
    "test:android": "node ../../tools/run-gradle.mjs testDemoDebugUnitTest",
    "test:coverage": "npm run coverage",
    "coverage": "node ../../tools/run-gradle.mjs jacocoTestReport jacocoTestCoverageVerification",
    "lint": "node ../../tools/run-gradle.mjs lintDemoDebug",
    "build:apk": "node ../../tools/run-gradle.mjs assembleDemoRelease",
    "install:android": "node ../../tools/run-gradle.mjs installDemoRelease"
  },
  "engines": {
    "node": ">=20"
  }
}
